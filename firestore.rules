      match /report_resolutions/{id} {
        allow read: if true;
        allow create: if activeAccount() && (request.resource.data.keys().hasOnly(['reportId', 'resolvedBy', 'resolvedAt',
          'targetType', 'targetId', 'problemType', 'category', 'previousStatus', 'status'])
          && owner(get(/databases/$(database)/documents/sample_test/shared/reports/$(id)).data.userId)
          && get(/databases/$(database)/documents/sample_test/shared/reports/$(id)).data.status == 'active'
          && request.resource.data.reportId == id && request.resource.data.resolvedBy == request.auth.uid
          && request.resource.data.resolvedAt == request.time
          && request.resource.data.previousStatus == 'active' && request.resource.data.status == 'resolved'
          && request.resource.data.targetType == get(/databases/$(database)/documents/sample_test/shared/reports/$(id)).data.targetType
          && request.resource.data.targetId == get(/databases/$(database)/documents/sample_test/shared/reports/$(id)).data.targetId
          && request.resource.data.problemType == get(/databases/$(database)/documents/sample_test/shared/reports/$(id)).data.problemType
          && request.resource.data.category == get(/databases/$(database)/documents/sample_test/shared/reports/$(id)).data.category
          && getAfter(/databases/$(database)/documents/sample_test/shared/reports/$(id)).data.status == 'resolved'
          && getAfter(/databases/$(database)/documents/sample_test/shared/reports/$(id)).data.resolvedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/sample_test/shared/reports/$(id)).data.resolvedAt == request.time);
        allow update, delete: if activeAccount() && (admin());
      }
      function assistanceDriver(d) {
        return d.get('policyVersion', 1) != 2 ? assignedOperator(d.busId) :
          (signedIn() && d.driverId == request.auth.uid && assignedOperator(d.busId)
            && get(/databases/$(database)/documents/sample_test/shared/service_runs/$(d.serviceRunId)).data.status in ['scheduled','boarding','in_progress']
            && (get(/databases/$(database)/documents/sample_test/shared/service_runs/$(d.serviceRunId)).data.status == 'scheduled'
              || get(/databases/$(database)/documents/sample_test/shared/service_runs/$(d.serviceRunId)).data.driverId == request.auth.uid));
      }
      match /boarding_requests/{id} {
        // A signed-in creator must be able to check a missing ID in a transaction.
        allow get: if (signedIn() && resource == null) || owner(resource.data.riderId)
          || assistanceDriver(resource.data) || admin();
        allow list: if owner(resource.data.riderId) || assistanceDriver(resource.data) || admin();
        allow create: if activeAccount() && (owner(request.resource.data.riderId)
          && (!exists(/databases/$(database)/documents/sample_test/shared/assistance_config/active) || get(/databases/$(database)/documents/sample_test/shared/assistance_config/active).data.enabled != true)
          && request.resource.data.keys().hasOnly(['riderId', 'riderName', 'busId', 'routeNo', 'stationId', 'stopName',
            'assistanceTypes', 'status', 'createdAt', 'purpose'])
          && realCatalogue('buses', request.resource.data.busId)
          && get(/databases/$(database)/documents/sample_test/shared/buses/$(request.resource.data.busId)).data.get('catalogueRecordType', 'vehicle') != 'published_timetable'
          && realCatalogue('stations', request.resource.data.stationId)
          && request.resource.data.stationId in get(/databases/$(database)/documents/sample_test/shared/buses/$(request.resource.data.busId)).data.stops
          && nonempty(request.resource.data.riderName, 100) && nonempty(request.resource.data.stopName, 200)
          && request.resource.data.assistanceTypes is list && request.resource.data.assistanceTypes.size() > 0
          && request.resource.data.get('purpose', 'boarding') in ['boarding', 'alighting']
          && request.resource.data.assistanceTypes.hasOnly(request.resource.data.get('purpose', 'boarding') == 'alighting'
            ? ['Deploy Ramp', 'Extra Time', 'Alighting Help'] : ['Deploy Ramp', 'Extra Time', 'Boarding Help'])
          && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time);
        allow update: if resource.data.get('policyVersion', 1) != 2 && activeAccount() && (admin() || (changesOnly(['status']) && (
          (owner(resource.data.riderId) && resource.data.status in ['pending', 'acknowledged'] && request.resource.data.status == 'cancelled')
          || (assignedOperator(resource.data.busId) && (
            (resource.data.status == 'pending' && request.resource.data.status in ['acknowledged', 'rejected'])
            || (resource.data.status == 'acknowledged' && request.resource.data.status == 'completed'))))));
        allow delete: if resource.data.get('policyVersion', 1) != 2 && activeAccount() && (admin());
      }
      match /{document=**} { allow read, write: if false; }

    }
  }
}
