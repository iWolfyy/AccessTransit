# Set default behavior to automatic text normalization
* text=auto

# Explicitly declare text files to use LF line endings
*.dart text eol=lf
*.rules text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.jar binary
