rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // AC-48: Users collection — profiles linked to Firebase Auth UID.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Journeys — passengers can create/read/update their own journeys.
    match /journeys/{journeyId} {
      allow create: if request.auth != null
        && request.resource.data.passengerId == request.auth.uid;
      allow read, update: if request.auth != null
        && resource.data.passengerId == request.auth.uid;
    }

    // Live bus locations — any authenticated user can read; operators write.
    match /live_locations/{busId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
