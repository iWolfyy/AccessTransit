rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the authenticated user has an operator role.
    function isOperator() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator';
    }

    // AC-48: Users collection — user profiles linked to Firebase Auth UID.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Journeys — passengers can create/read/update their own journeys.
    match /journeys/{journeyId} {
      allow create: if request.auth != null
        && request.resource.data.passengerId == request.auth.uid;
      allow read, update: if request.auth != null
        && resource.data.passengerId == request.auth.uid;
    }

    // Live bus telemetry locations — authenticated users read; telemetry updates allowed.
    match /live_locations/{busId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // AC-68 / AC-69: Stations — readable by any signed-in user; editable by operators.
    match /stations/{stationId} {
      allow read: if request.auth != null;
      allow write: if isOperator();
    }

    // AC-68 / AC-70: Buses — readable by any signed-in user; editable only by operators.
    match /buses/{busId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isOperator();
    }

    // AC-68: Reports — readable by signed-in users; users can only create reports with their own userId.
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
    }
  }
}
