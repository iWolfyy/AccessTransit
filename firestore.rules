rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function sessionPermitted(state) {
      return state.get('authDisabled', false) != true && state.get('accountDeleted', false) != true
        && request.auth.token.get('auth_time', 0) >= state.get('sessionsValidAfterSeconds', 0);
    }
    function signedIn() {
      return authenticated() && (!exists(/databases/$(database)/documents/account_access/$(request.auth.uid))
        || sessionPermitted(get(/databases/$(database)/documents/account_access/$(request.auth.uid)).data));
    }
    function accessPermitsWrites(state) {
      return sessionPermitted(state) && state.get('permanent', false) != true && state.get('communityPermanent', false) != true && state.get('manualSuspended', false) != true
        && (state.get('communitySuspendedUntil', null) == null || state.communitySuspendedUntil <= request.time)
        && (state.get('manualSuspendedUntil', null) == null || state.manualSuspendedUntil <= request.time);
    }
    function activeAccount() {
      return signedIn() && (!exists(/databases/$(database)/documents/account_access/$(request.auth.uid))
        || accessPermitsWrites(get(/databases/$(database)/documents/account_access/$(request.auth.uid)).data));
    }
    function v2Enabled() {
      return exists(/databases/$(database)/documents/moderation_config/active)
        && get(/databases/$(database)/documents/moderation_config/active).data.get('enabled', false) == true;
    }
    match /moderation_config/{id} { allow get: if signedIn(); allow list, write: if false; }
    match /account_access/{uid} { allow get: if authenticated() && request.auth.uid == uid; allow list, write: if false; }
    match /contribution_summaries/{uid} { allow get: if owner(uid); allow list, write: if false; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    match /route_geometries/{id} {
      allow read: if true;
      allow create, update: if activeAccount() && admin()
        && request.resource.data.routeId == id && request.resource.data.reviewed is bool
        && request.resource.data.synthetic is bool && nonempty(request.resource.data.version,128)
        && request.resource.data.points is list && request.resource.data.points.size() >= 2 && request.resource.data.points.size() <= 5000
        && request.resource.data.stops is list && request.resource.data.stops.size() >= 2 && request.resource.data.stops.size() <= 300
        && request.resource.data.stopVertices is list && request.resource.data.stopVertices.size() == request.resource.data.stops.size()
        && nonempty(request.resource.data.source,2048) && nonempty(request.resource.data.reviewReason,2000)
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /fare_publications/{id} {
      allow read: if admin() || resource.data.state == 'published';
      allow create: if activeAccount() && admin()
        && request.resource.data.schemaVersion == 1 && request.resource.data.state == 'published'
        && request.resource.data.synthetic is bool && request.resource.data.busIds is list
        && request.resource.data.busIds.size() > 0 && request.resource.data.busIds.size() <= 30
        && request.resource.data.table.reviewed == true && request.resource.data.mapping.reviewed == true
        && request.resource.data.mapping.tariffId == id
        && request.resource.data.table.routePatternId == request.resource.data.mapping.routePatternId
        && request.resource.data.table.serviceClass == request.resource.data.mapping.serviceClass
        && request.resource.data.validFromAt is timestamp && request.resource.data.validUntilAt is timestamp
        && request.resource.data.validFromAt < request.resource.data.validUntilAt
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && nonempty(request.resource.data.reviewReason, 2000);
      allow update: if activeAccount() && admin() && resource.data.state == 'published'
        && request.resource.data.state == 'archived' && changesOnly(['state','archiveReason','updatedBy','updatedAt'])
        && nonempty(request.resource.data.archiveReason, 2000)
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function validFareSnapshot(d) {
      let q = d.fareQuote;
      let p = get(/databases/$(database)/documents/fare_publications/$(q.tariffId)).data;
      return q.keys().hasOnly(['amountMinor','currency','tariffId','tariffVersion','mappingId','mappingVersion','source','serviceDate',
          'routePatternId','serviceClass','boardingOccurrenceId','alightingOccurrenceId'])
        && p.state == 'published' && d.busId in p.busIds && q.mappingId == q.tariffId
        && q.currency == 'LKR' && q.tariffVersion == p.table.version && q.mappingVersion == p.mapping.version
        && q.source == p.table.source && q.serviceClass == p.table.serviceClass && q.routePatternId == p.table.routePatternId
        && q.routePatternId == get(/databases/$(database)/documents/buses/$(d.busId)).data.routeId
        && q.boardingOccurrenceId == d.fromStationId && q.alightingOccurrenceId == d.toStationId
        && d.departureAt >= p.validFromAt && d.departureAt < p.validUntilAt
        && q.amountMinor is int && q.amountMinor > 0
        && q.amountMinor == p.table.amounts[p.mapping.stageByOccurrence[d.fromStationId]][p.mapping.stageByOccurrence[d.toStationId]];
    }
    // Approval is provisioned by the project owner/Admin SDK, never by a profile role.
    function approvedOperator() {
      return signedIn() && exists(/databases/$(database)/documents/operator_access/$(request.auth.uid))
        && get(/databases/$(database)/documents/operator_access/$(request.auth.uid)).data.approved == true;
    }
    function realCatalogue(kind, id) {
      let d = get(/databases/$(database)/documents/$(kind)/$(id)).data;
      return d != null && d.get('deletionPending', false) != true
        && d.get('isDemo', false) != true && d.get('catalogueSource', '') != 'demo';
    }
    function assignedOperator(busId) {
      return approvedOperator() && realCatalogue('buses', busId)
        && allowedOperatorRoute(get(/databases/$(database)/documents/buses/$(busId)).data.get('routeId', ''))
        && get(/databases/$(database)/documents/buses/$(busId)).data.get('catalogueRecordType', 'vehicle') != 'published_timetable'
        && get(/databases/$(database)/documents/buses/$(busId)).data.get('driverId', '') == request.auth.uid;
    }
    function allowedOperatorRoute(routeId) {
      return approvedOperator() && realCatalogue('routes', routeId)
        && exists(/databases/$(database)/documents/driver_route_assignments/$(request.auth.uid))
        && get(/databases/$(database)/documents/driver_route_assignments/$(request.auth.uid)).data.get('active', false) == true
        && get(/databases/$(database)/documents/driver_route_assignments/$(request.auth.uid)).data.get('routeId', '') == routeId;
    }
    function text(value, max) { return value is string && value.size() <= max; }
    function nonempty(value, max) { return text(value, max) && value.size() > 0; }
    function changesOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    // A minimal owner-only server timestamp receipt; it grants no role or rewards.
    match /search_clock/{uid} {
      allow get: if owner(uid);
      allow delete: if activeAccount() && (owner(uid));
      allow list: if false;
      allow create, update: if activeAccount() && (owner(uid)
        && request.resource.data.keys().hasOnly(['serverTime'])
        && request.resource.data.serverTime == request.time);
    }
    match /operator_access/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow write: if activeAccount() && (admin());
    }
    match /driver_route_assignments/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create, delete: if activeAccount() && (admin());
      allow update: if activeAccount() && (admin() || (owner(uid) && allowedOperatorRoute(resource.data.get('routeId', ''))
        && changesOnly(['claimRevision', 'lastClaimedBusId'])
        && request.resource.data.claimRevision is int
        && request.resource.data.claimRevision == resource.data.get('claimRevision', 0) + 1
        && realCatalogue('buses', request.resource.data.lastClaimedBusId)
        && getAfter(/databases/$(database)/documents/buses/$(request.resource.data.lastClaimedBusId)).data.get('driverId', '') == uid
        && getAfter(/databases/$(database)/documents/buses/$(request.resource.data.lastClaimedBusId)).data.get('routeId', '') == resource.data.routeId));
    }
    function recordedClaim(busId) {
      let before = get(/databases/$(database)/documents/driver_route_assignments/$(request.auth.uid)).data;
      let after = getAfter(/databases/$(database)/documents/driver_route_assignments/$(request.auth.uid)).data;
      return after.get('lastClaimedBusId', '') == busId && after.get('claimRevision', 0) == before.get('claimRevision', 0) + 1;
    }
    match /admin_audit/{id} {
      allow read: if admin();
      allow create: if activeAccount() && (admin());
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if activeAccount() && (owner(uid) && request.resource.data.keys().hasOnly(
          ['uid', 'name', 'email', 'phone', 'role', 'createdAt', 'points', 'reportsSubmitted', 'verifiedCount'])
        && request.resource.data.uid == uid && nonempty(request.resource.data.name, 100)
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.phone == null || text(request.resource.data.phone, 40))
        && request.resource.data.role in ['passenger', 'contributor', 'operator']
        && request.resource.data.createdAt == request.time
        && request.resource.data.points == 0 && request.resource.data.reportsSubmitted == 0
        && request.resource.data.verifiedCount == 0);
      allow update: if activeAccount() && (admin() || (owner(uid) && changesOnly(['name', 'phone', 'email'])
        && nonempty(request.resource.data.name, 100) && request.resource.data.email == request.auth.token.email
        && (request.resource.data.phone == null || text(request.resource.data.phone, 40))));
      allow delete: if activeAccount() && (admin());
    }
    match /journeys/{id} {
      allow get: if (signedIn() && resource == null) || owner(resource.data.passengerId) || admin();
      allow list: if owner(resource.data.passengerId) || admin();
      allow create: if activeAccount() && (owner(request.resource.data.passengerId)
        && request.resource.data.keys().hasOnly(['journeyId', 'passengerId', 'routeId', 'routeNumber',
          'routeTitle', 'busId', 'origin', 'destination', 'status', 'createdAt', 'fromStationId', 'toStationId',
          'selectedDate', 'selectedTimeMinutes', 'departureAt', 'durationMinutes', 'estimatedFareLkr', 'busNo',
          'wheelchairAccessRequired', 'stepFreeOnly', 'serviceRunId','fareQuote','scheduleSnapshot'])
        && request.resource.data.journeyId == id && request.resource.data.createdAt == request.time
        && request.resource.data.status in ['confirmed', 'active']
        && realCatalogue('buses', request.resource.data.busId)
        && nonempty(request.resource.data.origin, 200) && nonempty(request.resource.data.destination, 200)
        && validJourneySelection(request.resource.data)
        && validSavedTimetable(request.resource.data)
        && (!request.resource.data.keys().hasAny(['fareQuote']) || validFareSnapshot(request.resource.data))
        && (!request.resource.data.keys().hasAny(['serviceRunId']) || (
          request.resource.data.serviceRunId is string
          && get(/databases/$(database)/documents/service_runs/$(request.resource.data.serviceRunId)).data.busId == request.resource.data.busId
          && get(/databases/$(database)/documents/service_runs/$(request.resource.data.serviceRunId)).data.initialStopTimes[request.resource.data.fromStationId].estimatedArrival == request.resource.data.departureAt)));
      allow update: if activeAccount() && (admin() || (owner(resource.data.passengerId) && changesOnly(['status'])
        && resource.data.status in ['confirmed', 'active'] && request.resource.data.status in ['completed', 'cancelled']));
      allow delete: if activeAccount() && (owner(resource.data.passengerId) || admin());
    }
    function validSavedTimetable(d) {
      let s=d.get('scheduleSnapshot',null);
      return s==null || (s is map && s.keys().hasOnly(['schemaVersion','stops','stationIds','names','times','runVersion'])
        && s.schemaVersion==1 && s.stops is list && s.stops.size()>=2 && s.stops.size()<=300
        && s.stops.toSet().size()==s.stops.size()
        && s.stops[0]==d.fromStationId && s.stops[s.stops.size()-1]==d.toStationId
        && get(/databases/$(database)/documents/buses/$(d.busId)).data.stops.hasAll(s.stops)
        && s.stationIds is map && s.names is map && s.times is map
        && s.stationIds.keys().hasAll(s.stops) && s.names.keys().hasAll(s.stops) && s.times.keys().hasAll(s.stops)
        && s.times[d.fromStationId]==d.departureAt
        && s.times[d.toStationId]==d.departureAt + duration.value(d.durationMinutes,'m')
        && (!s.keys().hasAny(['runVersion']) || (s.runVersion is int && s.runVersion>=1
          && s.runVersion==get(/databases/$(database)/documents/service_runs/$(d.serviceRunId)).data.get('scheduleVersion',1))));
    }
    function validJourneySelection(d) {
      // Older schemas remain readable/creatable; any new selection fields require a complete selection.
      return !d.keys().hasAny(['fromStationId', 'toStationId', 'selectedDate', 'departureAt']) || (
        d.fromStationId in get(/databases/$(database)/documents/buses/$(d.busId)).data.stops
        && d.toStationId in get(/databases/$(database)/documents/buses/$(d.busId)).data.stops
        && d.fromStationId != d.toStationId
        && exists(/databases/$(database)/documents/stations/$(get(/databases/$(database)/documents/buses/$(d.busId)).data.get('stopStationIds', {}).get(d.fromStationId, d.fromStationId)))
        && exists(/databases/$(database)/documents/stations/$(get(/databases/$(database)/documents/buses/$(d.busId)).data.get('stopStationIds', {}).get(d.toStationId, d.toStationId)))
        && d.selectedDate is timestamp && d.departureAt is timestamp
        && (d.get('selectedTimeMinutes', null) == null || (d.selectedTimeMinutes is int && d.selectedTimeMinutes >= 0 && d.selectedTimeMinutes < 1440))
        && d.durationMinutes is int && d.durationMinutes > 0
        && d.estimatedFareLkr is int && d.estimatedFareLkr >= 0
        && d.wheelchairAccessRequired is bool && d.stepFreeOnly is bool);
    }
    match /reward_ledger/{id} {
      allow read: if admin();
      allow write: if activeAccount() && (admin());
      match /revisions/{revision} { allow read: if admin();
      allow write: if activeAccount() && (admin()); }
    }
    match /stations/{id} { allow read: if true; allow write: if activeAccount() && (admin()); }
    match /routes/{id} { allow read: if true; allow write: if activeAccount() && (admin()); }
    match /buses/{busId} {
      allow read: if true;
      allow create, delete: if activeAccount() && (admin());
      allow update: if activeAccount() && (admin() || (allowedOperatorRoute(resource.data.get('routeId', ''))
        && realCatalogue('buses', busId)
        && resource.data.get('catalogueRecordType', 'vehicle') != 'published_timetable'
        && resource.data.get('isDemo', false) != true && resource.data.get('catalogueSource', '') != 'demo'
        && ((resource.data.get('driverId', '') in ['', null]
          && request.resource.data.driverId == request.auth.uid && changesOnly(['driverId']) && recordedClaim(busId))
        || (resource.data.get('driverId', '') == request.auth.uid
          && request.resource.data.driverId == resource.data.driverId
          && changesOnly(['rampOk', 'occupancy', 'rampCheckedAt', 'rampCheckedBy'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rampOk', 'rampCheckedAt', 'rampCheckedBy'])
            || (request.resource.data.rampOk is bool && request.resource.data.rampCheckedBy == request.auth.uid
              && request.resource.data.rampCheckedAt == request.time))
          && request.resource.data.occupancy in ['low', 'medium', 'high']))));
    }
    function validTelemetry(busId) {
      let d = request.resource.data;
      return d.busId == busId && d.driverId == request.auth.uid && d.operatorId == request.auth.uid
        && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
        && !(d.latitude == 0 && d.longitude == 0)
        && d.speed is number && d.speed >= 0 && d.speed <= 200
        && d.timestamp is timestamp && d.timestamp <= request.time
        && d.status in ['active', 'stopped', 'offline', 'completed'] && d.isBroadcasting is bool;
    }
    function linkedTelemetry(busId) {
      let d = request.resource.data;
      let t = getAfter(/databases/$(database)/documents/trips/$(d.tripId)).data;
      return t.busId == busId && t.driverId == request.auth.uid && (
        (t.status == 'in_progress' && d.isBroadcasting == true && (
          t.get('serviceRunId', '') == '' || (
            getAfter(/databases/$(database)/documents/service_runs/$(t.serviceRunId)).data.status in ['boarding', 'in_progress']
            && getAfter(/databases/$(database)/documents/service_runs/$(t.serviceRunId)).data.get('handoverPending', false) == false
            && getAfter(/databases/$(database)/documents/operation_locks/$(request.auth.uid)).data.active == true
            && getAfter(/databases/$(database)/documents/operation_locks/$(request.auth.uid)).data.tripId == d.tripId)))
        || (t.status in ['completed', 'cancelled'] && d.isBroadcasting == false && d.status == 'completed'));
    }
    match /live_locations/{busId} {
      allow read: if true;
      allow create, update: if activeAccount() && (assignedOperator(busId) && validTelemetry(busId) && linkedTelemetry(busId)
        && (resource == null || resource.data.isBroadcasting == false || resource.data.tripId == request.resource.data.tripId));
      allow delete: if activeAccount() && (admin() || (assignedOperator(busId) && resource.data.isBroadcasting == false
        && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.status in ['completed','cancelled']));
    }
    match /active_buses/{busId} { allow read: if true; allow write: if activeAccount() && (admin()); }
    match /trips/{id} {
      allow read: if true;
      allow create: if activeAccount() && (assignedOperator(request.resource.data.busId) && request.resource.data.driverId == request.auth.uid
        && request.resource.data.tripId == id && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'in_progress' && validDatedTripStart(id));
      allow update: if activeAccount() && (assignedOperator(resource.data.busId) && resource.data.driverId == request.auth.uid
        && request.resource.data.busId == resource.data.busId && request.resource.data.driverId == resource.data.driverId
        && changesOnly(['status', 'actualDepartureTime', 'stopTimes', 'currentStopIndex'])
        && request.resource.data.status in ['in_progress', 'completed', 'cancelled']
        && ((resource.data.get('serviceRunId', '') == ''
          && (resource.data.status == 'in_progress' || request.resource.data.status == resource.data.status)) || validDatedTripUpdate(id)));
      allow delete: if activeAccount() && (admin());
    }
    function validDatedTripStart(id) {
      let d = request.resource.data;
      let r = get(/databases/$(database)/documents/service_runs/$(id)).data;
      let after = getAfter(/databases/$(database)/documents/service_runs/$(id)).data;
      let lock = getAfter(/databases/$(database)/documents/operation_locks/$(request.auth.uid)).data;
      let live = getAfter(/databases/$(database)/documents/live_locations/$(d.busId)).data;
      return d.serviceRunId == id && r.status == 'scheduled' && after.status == 'boarding'
        && d.busId == r.busId && d.stops == r.stops && d.stopTimes == r.initialStopTimes
        && d.scheduledDepartureTime == r.plannedDepartureAt && d.actualDepartureTime == null && d.currentStopIndex == 0
        && request.time >= r.plannedDepartureAt - duration.value(5, 'm') && request.time <= r.latestStartAt
        && r.latestStartAt == r.plannedDepartureAt + duration.value(30,'m')
        && lock.active == true && lock.tripId == id && lock.busId == d.busId
        // Lock writes enforce the prior driver lock; telemetry writes enforce bus
        // occupancy using their own resource, avoiding duplicate access calls.
        && live.tripId == id && live.isBroadcasting == true;
    }
    function validDatedTripUpdate(id) {
      let d = request.resource.data;
      let r = getAfter(/databases/$(database)/documents/service_runs/$(id)).data;
      let lock = getAfter(/databases/$(database)/documents/operation_locks/$(request.auth.uid)).data;
      let live = getAfter(/databases/$(database)/documents/live_locations/$(d.busId)).data;
      return d.currentStopIndex >= resource.data.currentStopIndex && d.currentStopIndex < d.stops.size()
        && d.currentStopIndex <= resource.data.currentStopIndex + 1 && live.tripId == id && lock.tripId == id
        && (d.actualDepartureTime == resource.data.actualDepartureTime ||
          (resource.data.actualDepartureTime == null && d.actualDepartureTime == request.time && r.actualDepartureAt == request.time))
        && ((d.status == 'in_progress' && lock.active == true && live.isBroadcasting == true && r.status in ['boarding', 'in_progress']
          && r.get('handoverPending', false) == false
          && (d.currentStopIndex == 0 || d.actualDepartureTime != null))
          || (d.status in ['completed','cancelled'] && r.status == d.status && lock.active == false && live.isBroadcasting == false
            && (d.status == 'cancelled' || d.actualDepartureTime != null)));
    }
    match /service_run_changes/{id} {
      allow read: if true;
      allow create: if activeAccount() && admin()
        && request.resource.data.previousRunId==id
        && request.resource.data.updatedBy==request.auth.uid
        && request.resource.data.updatedAt==request.time;
      allow update, delete: if false;
    }
    match /service_schedules/{id} {
      allow read: if admin();
      allow create: if activeAccount() && admin()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.version == 1
        && request.resource.data.state == 'published'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow update: if activeAccount() && admin()
        && resource.data.state == 'published'
        && request.resource.data.state == 'retired'
        && changesOnly(['state','updatedBy','updatedAt'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /service_runs/{id} {
      allow read: if true;
      allow create, delete: if activeAccount() && (admin());
      allow update: if activeAccount() && (admin() || (assignedOperator(resource.data.busId)
        && changesOnly(['status','driverId','tripId','startedAt','actualDepartureAt','completedAt'])
        && request.resource.data.driverId == request.auth.uid && request.resource.data.tripId == id
        && ((resource.data.status == 'scheduled' && request.resource.data.status == 'boarding'
          && request.time >= resource.data.plannedDepartureAt - duration.value(5,'m') && request.time <= resource.data.latestStartAt
          && resource.data.latestStartAt == resource.data.plannedDepartureAt + duration.value(30,'m')
          && request.resource.data.startedAt == request.time && request.resource.data.actualDepartureAt == null
          && (request.time <= resource.data.plannedDepartureAt || validLateNote(id))
          && getAfter(/databases/$(database)/documents/trips/$(id)).data.serviceRunId == id
          && getAfter(/databases/$(database)/documents/operation_locks/$(request.auth.uid)).data.tripId == id)
        || (resource.data.status == 'boarding' && request.resource.data.status == 'in_progress'
          && request.resource.data.actualDepartureAt == request.time
          && getAfter(/databases/$(database)/documents/trips/$(id)).data.actualDepartureTime == request.time)
        || (resource.data.status in ['boarding','in_progress','completed','cancelled']
          && request.resource.data.status in ['completed','cancelled'] && request.resource.data.completedAt == request.time
          && getAfter(/databases/$(database)/documents/trips/$(id)).data.status == request.resource.data.status
          && getAfter(/databases/$(database)/documents/operation_locks/$(request.auth.uid)).data.active == false))));
    }
    match /operation_locks/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow delete: if activeAccount() && (admin());
      allow create, update: if activeAccount() && (admin() || (owner(uid) && assignedOperator(request.resource.data.busId)
        && request.resource.data.keys().hasOnly(['active','busId','tripId','updatedAt']) && request.resource.data.updatedAt == request.time
        && ((request.resource.data.active == true
          && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.driverId == uid
          && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.busId == request.resource.data.busId
          && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.serviceRunId == request.resource.data.tripId
          && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.status == 'in_progress'
