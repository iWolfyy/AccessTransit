        && request.resource.data.status == 'active' && request.resource.data.confirmCount == 0 && request.resource.data.falseCount == 0;
      allow update: if admin() || ownVoteOnly() || ownRecheck(id) || (owner(resource.data.userId)
        && resource.data.status == 'active' && changesOnly(['status', 'resolvedBy', 'resolvedAt'])
        && request.resource.data.status == 'resolved' && request.resource.data.resolvedBy == request.auth.uid
