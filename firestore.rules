rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Journeys
    match /journeys/{journeyId} {
      allow read, write: if true;
    }

    // Live bus locations
    match /live_locations/{busId} {
      allow read, write: if true;
    }

    // Stations
    match /stations/{stationId} {
      allow read, write: if true;
    }

    // Buses
    match /buses/{busId} {
      allow read, write: if true;
    }

    // AC-68 / AC-77: Reports — readable and writable by signed-in & guest users
    match /reports/{reportId} {
      allow read, write: if true;
    }
  }
}
