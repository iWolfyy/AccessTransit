      allow list: if owner(resource.data.riderId) || assignedOperator(resource.data.busId) || admin();
      allow create: if owner(request.resource.data.riderId)
        && request.resource.data.keys().hasOnly(['riderId', 'riderName', 'busId', 'routeNo', 'stationId', 'stopName',
          'assistanceTypes', 'status', 'createdAt', 'purpose'])
        && realCatalogue('buses', request.resource.data.busId)
        && get(/databases/$(database)/documents/buses/$(request.resource.data.busId)).data.get('catalogueRecordType', 'vehicle') != 'published_timetable'
        && realCatalogue('stations', request.resource.data.stationId)
