        && getAfter(/databases/$(database)/documents/report_resolutions/$(id)).data.resolvedAt == request.time);
      allow delete: if admin() || owner(resource.data.userId);
      match /rechecks/{checkId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['reportId', 'userId', 'checkedAt'])
          && request.resource.data.reportId == id && request.resource.data.userId == request.auth.uid
          && request.resource.data.checkedAt == request.time
          && getAfter(/databases/$(database)/documents/reports/$(id)).data.lastRecheckId == checkId
          && getAfter(/databases/$(database)/documents/reports/$(id)).data.lastRecheckedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/reports/$(id)).data.lastRecheckedAt == request.time
          && get(/databases/$(database)/documents/reports/$(id)).data.get('lastRecheckId', '') != checkId;
        allow update, delete: if false;
      }
    }
    match /report_resolutions/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['reportId', 'resolvedBy', 'resolvedAt',
        'targetType', 'targetId', 'problemType', 'category', 'previousStatus', 'status'])
        && owner(get(/databases/$(database)/documents/reports/$(id)).data.userId)
        && get(/databases/$(database)/documents/reports/$(id)).data.status == 'active'
        && request.resource.data.reportId == id && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.previousStatus == 'active' && request.resource.data.status == 'resolved'
        && request.resource.data.targetType == get(/databases/$(database)/documents/reports/$(id)).data.targetType
        && request.resource.data.targetId == get(/databases/$(database)/documents/reports/$(id)).data.targetId
        && request.resource.data.problemType == get(/databases/$(database)/documents/reports/$(id)).data.problemType
        && request.resource.data.category == get(/databases/$(database)/documents/reports/$(id)).data.category
        && getAfter(/databases/$(database)/documents/reports/$(id)).data.status == 'resolved'
        && getAfter(/databases/$(database)/documents/reports/$(id)).data.resolvedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/reports/$(id)).data.resolvedAt == request.time;
      allow update, delete: if admin();
    }
    match /boarding_requests/{id} {
